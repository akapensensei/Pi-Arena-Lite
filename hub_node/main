"""
================================================================================
Pi Arena Lite - hub_node/main.py
Distributed Practice Field Controller for FRC 2026: REBUILT™

STUDENT EDUCATIONAL OVERVIEW:
1. APPLIANCE ARCHITECTURE: This script is designed to run as a 'System Service.'
   It has no UI because its only job is to be a reliable sensor/light drone.
2. DEPENDENCY INJECTION: We "plug" the network function into the sensor class. 
   The sensor doesn't need to know HOW the network works; it just calls the 
   function we give it. This makes the code modular and easier to test.
3. MULTI-MODE LOGIC: The Hub listens for the 'field_mode' (FULL, RED, or BLUE).
   If the Master is in "Solo Mode" for the opposite alliance, this Hub 
   automatically dims its LEDs to signal it is in "Quiet/Debug" mode.
4. PACKET PARSING: We use JSON to decode instructions from the Master Node, 
   ensuring the Hub stays perfectly in sync with the 2026 Match Timer.

Attribution:
- Core Match Logic: Derived from Cheesy Arena by Team 254 The Cheesy Poofs (BSD 3-Clause).
- Technical Inspiration: Influence from Team 3476 Code Orange.
- Game Rules: Based on official FIRST® REBUILT™ 2026 documentation.
- Implementation: Developed as MIT-Licensed Open Source by Team 3476 Code Orange, 
  with architectural assistance from Google Gemini.
================================================================================
"""

import time
import sys
from common.network_utils import ArenaNetwork
from hub_node.sensors import FuelSensor
from hub_node.leds import HubLights

class PiArenaLiteHub:
    def __init__(self, alliance="RED", master_ip="192.168.1.10"):
        self.alliance = alliance
        self.master_ip = master_ip
        
        # 1. HARDWARE INITIALIZATION
        # Sensors monitor the Hub intake; Lights provide feedback to Drive Teams.
        self.sensors = FuelSensor(pins=[17, 27, 22, 23], node_id=f"HUB_{alliance}")
        self.lights = HubLights()
        
        # 2. NETWORKING
        # Each hub acts as a UDP node in the field mesh.
        self.net = ArenaNetwork(node_role=f"HUB_{alliance}")
        
        # LINKING: We inject the network broadcast method into the sensor object.
        self.sensors.broadcast_score = self.send_score_to_master
        
        # 3. STATE LISTENER: The Hub is 'Passive'—it waits for the Master's command.
        self.net.listen(self.handle_master_updates)
        
        print(f"[READY] {self.alliance} Hub Online. Syncing with Master at {self.master_ip}")
        self.lights.game_state_update("IDLE")

    def handle_master_updates(self, data, addr):
        """
        Processes 'STATE_UPDATE' packets. 
        Determines visual status based on 2026 Shift Rules and Practice Modes.
        """
        if data.get("type") == "STATE_UPDATE":
            state = data.get("state")
            field_mode = data.get("field_mode", "FULL") 
            
            # Practice Mode Filter: Should this Hub be 'awake'?
            is_mode_active = (field_mode == "FULL" or field_mode == self.alliance)
            
            # Placeholder for 2026 Hub Shift Game Data logic
            is_shift_active = True 
            
            if is_mode_active:
                # Standard Match Feedback
                self.lights.game_state_update(state, is_active=is_shift_active)
            else:
                # Solo Practice: Dim the inactive side of the field
                self.lights.set_color(0) 

            # Match Reset Logic
            if state == "IDLE":
                self.sensors.reset_score()

    def send_score_to_master(self):
        """Sends score packets to Node 1 via the UDP backbone."""
        self.net.send_score_update(self.alliance, 1, self.master_ip)

    def run(self):
        """Main execution loop."""
        try:
            while True:
                time.sleep(1)
        except KeyboardInterrupt:
            self.lights.set_color(0)
            print(f"\n[{self.alliance}] Hub Appliance Shutting Down.")

if __name__ == "__main__":
    # Start via: python3 -m hub_node.main RED 192.168.1.10
    color = sys.argv[1] if len(sys.argv) > 1 else "RED"
    ip = sys.argv[2] if len(sys.argv) > 2 else "192.168.1.10"
    
    hub = PiArenaLiteHub(alliance=color, master_ip=ip)
    hub.run()
